[Unit]
Description=Central Single Sign-On (SSO) & Identity Service
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/SSO
EnvironmentFile=/var/www/SSO/.env
ExecStart=/var/www/SSO/venv/bin/python run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
